+    MPI_ECP_SUB(&R->X, &B,      &C);
+    MPI_ECP_SUB(&R->X, &R->X,   &D);
+    MPI_ECP_MUL(&R->X, &R->X,   &J);
+    /* Y3 = F*(E-D) */
+    MPI_ECP_SUB(&R->Y, &E,      &D);
+    MPI_ECP_MUL(&R->Y, &R->Y,   &F);
+    /* Z3 = F*J */
+    MPI_ECP_MUL(&R->Z, &F,      &J);
+
+cleanup:
+    mbedtls_mpi_free(&A); mbedtls_mpi_free(&B); mbedtls_mpi_free(&C);
+    mbedtls_mpi_free(&D); mbedtls_mpi_free(&E); mbedtls_mpi_free(&F);
+    mbedtls_mpi_free(&J);
+
+    return ret;
+}
