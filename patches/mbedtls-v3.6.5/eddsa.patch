+    MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary_le(&q, buf, plen));
+    ret = mbedtls_ecp_point_decode(grp, pt, &q);
+
+cleanup:
+    mbedtls_mpi_free(&q);
+    return ret;
+}
