+       x^2 = (y^2 - 1) / (d y^2 - a) (mod p). The denominator is always
+       non-zero mod p. Let u = y^2 - 1 and v = d y^2 - a. */
+
+    MPI_ECP_MUL(&u, &pt->Y,  &pt->Y);
+    MPI_ECP_MUL(&v, &grp->B, &u);
+    MPI_ECP_SUB(&v, &v,      &grp->A);
+    MPI_ECP_SUB_INT(&u, &u, 1);
