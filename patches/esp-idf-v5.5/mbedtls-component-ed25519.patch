diff --git a/components/mbedtls/Kconfig b/components/mbedtls/Kconfig
index 621610a0..1c408d37 100644
--- a/components/mbedtls/Kconfig
+++ b/components/mbedtls/Kconfig
@@ -1065,6 +1065,13 @@ menu "mbedTLS"
         help
             Enable ECDSA. Needed to use ECDSA-xxx TLS ciphersuites.
 
+    config MBEDTLS_EDDSA_C
+        bool "Edwards-curve Digital Signature Algorithm (EdDSA)"
+        depends on MBEDTLS_ECP_C && MBEDTLS_ECP_DP_ED25519_ENABLED && MBEDTLS_SHA512_C
+        default n
+        help
+            Enable EdDSA support for Ed25519.
+
     config MBEDTLS_ECJPAKE_C
         bool "Elliptic curve J-PAKE"
         depends on MBEDTLS_ECP_C
@@ -1156,6 +1163,13 @@ menu "mbedTLS"
         help
             Enable support for CURVE25519 Elliptic Curve.
 
+    config MBEDTLS_ECP_DP_ED25519_ENABLED
+        bool "Enable Ed25519 curve"
+        depends on MBEDTLS_ECP_C
+        default n
+        help
+            Enable support for the Ed25519 Edwards curve.
+
     config MBEDTLS_ECP_NIST_OPTIM
         bool "NIST 'modulo p' optimisations"
         depends on MBEDTLS_ECP_C
