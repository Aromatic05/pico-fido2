# Hardware-oriented ESP32-S3 profile for host-provisioned keys and host-encrypted flash.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="pico-keys-sdk/config/esp32/partitions-secure.csv"
CONFIG_PARTITION_TABLE_FILENAME="pico-keys-sdk/config/esp32/partitions-secure.csv"

CONFIG_PICOKEYS_ESP32_REQUIRE_PROVISIONED_KEYS=y

CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="build-provisioning/secure_boot_signing_key.pem"
CONFIG_SECURE_BOOT_INSECURE=y
CONFIG_SECURE_BOOT_ALLOW_JTAG=y
CONFIG_SECURE_BOOT_ALLOW_UNUSED_DIGEST_SLOTS=y

CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_AES128=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y
CONFIG_SECURE_FLASH_REQUIRE_ALREADY_ENABLED=y
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_ENC=y

# Recovery-first experiment policy: do not enable ESP-IDF NVS Encryption until
# the partition table deliberately provides an nvs_keys partition. Flash
# Encryption remains enabled for the device; this avoids the startup-time
# nvs_sec_provider abort caused by a missing nvs_keys partition.
# CONFIG_NVS_ENCRYPTION is not set
